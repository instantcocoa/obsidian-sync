# systemd unit for the obsync server. Install:
#   sudo cp obsync /usr/local/bin/obsync
#   sudo cp obsync.service /etc/systemd/system/obsync.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now obsync
# Data lives in /var/lib/obsync (StateDirectory), created and owned by the
# unit's own transient user. There is no admin token: mint a create link for
# the first device with `sudo obsync vault create --data /var/lib/obsync`
# (the CLI drops to the directory's owner before writing). Put your domain
# in the ExecStart line. Behind Caddy use the second ExecStart instead and
# remove the two CAP_NET_BIND_SERVICE lines (see README.md, "Behind Caddy").
[Unit]
Description=obsync: end-to-end encrypted Obsidian vault sync
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/obsync serve --data /var/lib/obsync --acme-domain sync.example.com
# Behind Caddy (Caddyfile.example):
#ExecStart=/usr/local/bin/obsync serve --data /var/lib/obsync --listen 127.0.0.1:8080 --public-url https://sync.example.com --trust-proxy 127.0.0.1,::1
Restart=on-failure
RestartSec=5s

# Its own user with no shell, no home, no privileges beyond binding 80 and 443.
DynamicUser=yes
StateDirectory=obsync
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
UMask=0077

# The rest of the system is read-only or invisible to it.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
