# /etc/obsync/offsite.env  (root:root, mode 600)
# Read by obsync-offsite.sh after every nightly snapshot. Any S3-compatible
# store works; this is Hetzner Object Storage. Keep RESTIC_PASSWORD in your
# password manager too: without it the off-host copies cannot be read.
RESTIC_REPOSITORY=s3:https://nbg1.your-objectstorage.com/frobio-obsync-backup
RESTIC_PASSWORD=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
