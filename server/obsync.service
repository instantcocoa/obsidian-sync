# systemd unit for the obsync server. Install:
#   sudo cp obsync /usr/local/bin/obsync
#   sudo cp obsync.service /etc/systemd/system/obsync.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now obsync
# Data lives in /var/lib/obsync (StateDirectory), created and owned by the
# unit's own transient user; the admin token is written there on first start
# (sudo cat /var/lib/obsync/admin-token). Put your domain in the ExecStart line.
[Unit]
Description=obsync: end-to-end encrypted Obsidian vault sync
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/obsync serve --data /var/lib/obsync --acme-domain sync.example.com
Restart=on-failure
RestartSec=5s

# Its own user with no shell, no home, no privileges beyond binding 80 and 443.
DynamicUser=yes
StateDirectory=obsync
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
UMask=0077

# The rest of the system is read-only or invisible to it.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
